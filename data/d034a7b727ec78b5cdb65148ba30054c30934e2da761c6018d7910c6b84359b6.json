[{"id":"ba8fec44916e934cc88670b0","title":"赖总统国庆演说：共享AI经济成果、强化国防守护和平","source":"中央社 CNA","country":"台湾","url":"https://www.cna.com.tw/news/aipl/202610100137.aspx","publishedAt":"2026-10-10T08:15:16.000Z","translation":"订阅摘要 · 原文正文未核验\n\n赖清德在国庆演说中表示，增加国防投资旨在吓阻战争，并欢迎美中透过对话管理竞争、降低冲突风险。依据官方订阅摘要，正文未核验。","collectedAt":"2026-10-10T10:34:06.226Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-10T08:15:16.000Z"},{"id":"db031e36f629281b1d3ebf24","title":"赖清德呼吁加强防务，指责中国改变现状","source":"每日新闻 Mainichi","country":"日本","url":"https://mainichi.jp/english/articles/20261010/p2g/00m/0in/033000c","publishedAt":"2026-10-10T07:45:08.000Z","translation":"订阅摘要 · 原文正文未核验\n\n赖清德在周六演说中呼吁加强台湾防卫能力；报道标题称他指责中国改变现状。依据官方订阅标题与片段，正文未核验。","collectedAt":"2026-10-10T10:34:06.226Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-10T07:45:08.000Z"},{"id":"de1b31ee48b8f33c2a829b7c","title":"赖总统接见日本国会议员祝贺团，盼深化台日情谊","source":"中央社 CNA","country":"台湾","url":"https://www.cna.com.tw/news/aipl/202610100127.aspx","publishedAt":"2026-10-10T07:20:54.000Z","translation":"订阅摘要 · 原文正文未核验\n\n赖清德接见日本国会议员国庆祝贺团，感谢议员支持台湾，表示密切台日关系带来安全与安定，并期待延续友好情谊。依据官方订阅摘要，正文未核验。","collectedAt":"2026-10-10T10:34:06.226Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-10T07:20:54.000Z"},{"id":"033586e532ab105082446441","title":"回应赖总统国庆演说 美国务院：乐见维护台海和平稳定承诺","source":"中央社 CNA","country":"台湾","url":"https://www.cna.com.tw/news/aipl/202610110002.aspx","publishedAt":"2026-10-10T16:23:51.000Z","translation":"订阅摘要 · 原文正文未核验\n\n美国国务院向中央社表示，欢迎赖清德国庆演说中维护台海和平稳定的承诺。赖在演说中称，中国以军事与灰色地带行动施压，台湾将以负责任行动维护台海及印太现状。","collectedAt":"2026-10-10T20:02:05.022Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-10T16:23:51.000Z"},{"id":"1a987e1cba55943b1c24a9a1","title":"赖清德：乐见美中对话降低冲突风险","source":"自由时报","country":"台湾","url":"https://news.ltn.com.tw/news/politics/paper/1774032","publishedAt":"2026-10-10T21:30:00.000Z","translation":"订阅摘要 · 原文正文未核验\n\n赖清德国庆演说指出，中国持续以军事与灰色地带行动施压，台湾将推动国防改革。他欢迎美中通过对话管理竞争、降低冲突与战争风险，并强调尊重台湾人民生存权利。","collectedAt":"2026-10-11T00:56:18.979Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-10T21:30:00.000Z"},{"id":"27df306165ce2028583834be","title":"双十国庆认知战 知情人士称中共意图散播疑美与弃台论","source":"中央社 CNA","country":"台湾","url":"https://www.cna.com.tw/news/aipl/202610110124.aspx","publishedAt":"2026-10-11T07:30:28.000Z","translation":"订阅摘要 · 原文正文未核验\n\n中央社引述知情人士称，中共在双十国庆前后结合外交与温情叙事发动认知战，意图散播疑美、弃台论，台湾军方已主动反制。","collectedAt":"2026-10-11T10:46:49.028Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-11T07:30:28.000Z"},{"id":"acc8ddcb41382c94c6599018","title":"赖清德国庆强调吓阻战争 中国称绕台演训维护台湾安全","source":"自由时报","country":"台湾","url":"https://news.ltn.com.tw/news/politics/breakingnews/5602794","publishedAt":"2026-10-11T08:50:51.000Z","translation":"订阅摘要 · 原文正文未核验\n\n赖清德国庆演说强调，增加国防投资旨在吓阻战争，强化自卫并不意味着放弃对话。中国国防部随后批评其言论，并声称绕台演训维护台湾安全。","collectedAt":"2026-10-11T10:46:49.028Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-11T08:50:51.000Z"},{"id":"0e27a505eddfb85d89715302","title":"AIT前主席莫健：台海比20年前更危险","source":"自由时报","country":"台湾","url":"https://news.ltn.com.tw/news/politics/breakingnews/5603093","publishedAt":"2026-10-11T15:11:43.000Z","translation":"订阅摘要 · 原文正文未核验\n\n美国在台协会前主席莫健在台湾励志协会闭门讨论会上表示，当前台海比20年前更危险，并将风险上升归因于中国权力集中于一人。","collectedAt":"2026-10-11T20:13:33.388Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-11T15:11:43.000Z"},{"id":"5631f25dbf0aa5a6b344a0b9","title":"回应赖清德国庆“山巅之城”演说，美国务院欢迎维护台海和平稳定承诺","source":"自由时报","country":"台湾","url":"https://news.ltn.com.tw/news/politics/paper/1774140","publishedAt":"2026-10-11T21:30:00.000Z","translation":"订阅摘要 · 原文正文未核验\n\n据官方订阅摘要，美国国务院发言人欢迎赖清德国庆演说中维护台海和平稳定的承诺。赖称台湾将以负责任行动应对中国军事及灰色地带施压。正文未核验。","collectedAt":"2026-10-12T01:16:18.564Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-11T21:30:00.000Z"},{"id":"cb4a352d8096b897d59233c8","title":"赖清德国庆演说后，中国宣布在五处海域实施实弹射击","source":"自由时报","country":"台湾","url":"https://news.ltn.com.tw/news/politics/paper/1774183","publishedAt":"2026-10-11T21:30:00.000Z","translation":"订阅摘要 · 原文正文未核验\n\n据官方订阅摘要，中国多地海事局公告，10月12日至17日在东海、黄海、渤海及南海等五处海域实施实弹射击；中国国防部称常态演训意在震慑“台独”。正文未核验。","collectedAt":"2026-10-12T01:16:18.564Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-11T21:30:00.000Z"},{"id":"4c8f05e4857e03ede1141b85","title":"空军：F-16V Block 70电战荚舱硬件已安装，系统整合中","source":"中央社 CNA","country":"台湾","url":"https://www.cna.com.tw/news/aipl/202610120103.aspx","publishedAt":"2026-10-12T05:15:46.000Z","translation":"订阅摘要 · 原文正文未核验\n\n首批两架F-16V Block 70已抵台。空军表示，「蝮蛇之盾」电战荚舱部分硬件已安装，仍须与战机系统整合，并在交机后的规定期限内完成。","collectedAt":"2026-10-12T11:53:17.696Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-12T05:15:46.000Z"},{"id":"58fd419fda83d77ee5423daf","title":"美日利剑军演：分析指与那国岛部署导弹应对台海","source":"中央社 CNA","country":"台湾","url":"https://www.cna.com.tw/news/aipl/202610120076.aspx","publishedAt":"2026-10-12T04:01:48.000Z","translation":"订阅摘要 · 原文正文未核验\n\n中央社订阅摘要称，美国陆战队正准备在与那国岛部署两套反舰与防空导弹系统，分析认为此举旨在加强对中国舰队的威慑，应对台海风险。","collectedAt":"2026-10-12T11:53:17.696Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-12T04:01:48.000Z"},{"id":"98b777d4a93a0fcedeec7624","title":"行政院人士称将加快审议飞行军官奖金调整","source":"自由时报","country":"台湾","url":"https://news.ltn.com.tw/news/politics/paper/1774305","publishedAt":"2026-10-12T21:30:00.000Z","translation":"订阅摘要 · 原文正文未核验\n\n行政院人士表示，国防部提出的飞行军官续服现役奖助金及空勤加给调整已送审，目前由人事行政总处汇整意见，政院将加快审议并适时说明。","collectedAt":"2026-10-12T22:55:03.582Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-12T21:30:00.000Z"},{"id":"e9f95c7574590bf351088d5c","title":"中国来源资安软件涉嫌伪装台湾产品，进入外交部采购体系","source":"自由时报","country":"台湾","url":"https://news.ltn.com.tw/news/politics/paper/1774283","publishedAt":"2026-10-12T21:30:00.000Z","translation":"订阅摘要 · 原文正文未核验\n\n三家公司涉嫌将含中国原始码的软件改装为台湾产品，连续三年承接外交部采购，并安装于多处外馆电脑。外交部资安稽核发现异常后通报，台北地检署展开搜索与约谈。","collectedAt":"2026-10-12T22:55:03.582Z","dateType":"published","contentType":"rss_excerpt","rssPublishedAt":"2026-10-12T21:30:00.000Z"}]